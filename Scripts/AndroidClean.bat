@echo off
:: Copyright (c) - SurgeTechnologies - All rights reserved
:: Removes what the Android build generated in this repository, then the Android toolchain Scripts/AndroidSetup.bat installs,
:: to start over (for example to test the setup like a first-time user). Asks before every part. Only your user account is touched:
::   - the repository's Android build output, staged assets and Android\local.properties (asked first)
::   - the adb server and Gradle daemons running from the toolchain
::   - the Android SDK (NDK, CMake, platform-tools, ...) and the JDK 17 next to it
::   - Gradle's cache (~\.gradle) and Android's user data (~\.android: adb keys, emulator images)
::   - your user's JAVA_HOME / ANDROID_HOME / ANDROID_SDK_ROOT and PATH entries that point into them
:: System-wide installs (a JDK from an installer, Android Studio, machine environment variables) are only reported.
::
:: Usage: AndroidClean.bat [install dir] [/y]
::   install dir  What was passed to AndroidSetup.bat. Default: the folder above ANDROID_HOME, else %LOCALAPPDATA%\Android
::   /y           Yes to every question, no pause at the end
::   NO_COLOR=1   Plain output
setlocal EnableExtensions

call :InitColors

:: Before parsing the arguments: shift moves %%0 too
for %%i in ("%~dp0..") do set "REPO_DIR=%%~fi"

set "ASSUME_YES="
set "INSTALL_ARG="
:ParseArgs
if "%~1"=="" goto :ArgsDone
if "%~1"=="/?" goto :Usage
if /i "%~1"=="/y" (set "ASSUME_YES=1") else if /i "%~1"=="-y" (set "ASSUME_YES=1") else (set "INSTALL_ARG=%~f1")
shift
goto :ParseArgs
:ArgsDone

set "ANDROID_DIR=%REPO_DIR%\Android"

:: Same resolution as AndroidSetup.bat. The user's registry value wins over this terminal's (possibly stale) environment
set "USER_ANDROID_HOME="
for /f "tokens=2,*" %%a in ('reg query HKCU\Environment /v ANDROID_HOME 2^>nul ^| findstr /i "ANDROID_HOME"') do set "USER_ANDROID_HOME=%%b"
set "SDK_DIR="
if defined INSTALL_ARG set "SDK_DIR=%INSTALL_ARG%\Sdk"
if not defined SDK_DIR if defined USER_ANDROID_HOME set "SDK_DIR=%USER_ANDROID_HOME%"
if not defined SDK_DIR if defined ANDROID_HOME set "SDK_DIR=%ANDROID_HOME%"
if not defined SDK_DIR set "SDK_DIR=%LOCALAPPDATA%\Android\Sdk"
for %%i in ("%SDK_DIR%") do set "SDK_DIR=%%~fi"
for %%i in ("%SDK_DIR%\..") do set "INSTALL_DIR=%%~fi"
set "JDK_DIR=%INSTALL_DIR%\jdk-17"
set "GRADLE_DIR=%GRADLE_USER_HOME%"
if not defined GRADLE_DIR set "GRADLE_DIR=%USERPROFILE%\.gradle"
set "ANDROID_USER_DIR=%USERPROFILE%\.android"
:: Generated in Android\ by Gradle, Android Studio and the Export panel (staged assets, icon overlay)
set "PROJECT_ITEMS=".gradle" "build" ".idea" "app\build" "app\.cxx" "app\src\release" "app\src\main\assets" "local.properties""

echo.
echo %C_TITLE%============================================================%C_RESET%
echo %C_TITLE% Surge Android clean%C_RESET%
echo %C_TITLE%============================================================%C_RESET%
echo  %C_BOLD%Project%C_RESET%
call :ShowItem "Build output     " "%ANDROID_DIR%\app\build"
call :ShowItem "Native build     " "%ANDROID_DIR%\app\.cxx"
call :ShowItem "Staged assets    " "%ANDROID_DIR%\app\src\main\assets"
echo  %C_BOLD%Toolchain%C_RESET%
call :ShowItem "Android SDK + NDK" "%SDK_DIR%"
call :ShowItem "JDK 17           " "%JDK_DIR%"
call :ShowItem "Gradle cache     " "%GRADLE_DIR%"
call :ShowItem "Android user data" "%ANDROID_USER_DIR%"
echo.
echo  Every part is confirmed first. Deleted files do not go to the Recycle Bin.
echo %C_TITLE%============================================================%C_RESET%
echo.
call :Confirm "Start cleaning?" || goto :Cancelled

:: ---------------------------------------------------------------------------------------------------------------------
call :Section "Project generated files (regenerated by the next build or export)"
set "PROJECT_RETRY="
set "PROJECT_FOUND="
for %%p in (%PROJECT_ITEMS%) do if exist "%ANDROID_DIR%\%%~p" (set "PROJECT_FOUND=1" & call :Info "Android\%%~p")
if not defined PROJECT_FOUND (call :Info "Already clean." & goto :ProjectDone)
call :Confirm "Delete them?" || (call :Info "Kept." & goto :ProjectDone)
call :DeleteProjectFiles
if defined PROJECT_LEFT (call :Warn "In use, probably by a Gradle daemon:%PROJECT_LEFT%. Retried once the processes are stopped." & set "PROJECT_RETRY=1") else (call :Ok "Deleted")
:ProjectDone

echo.
call :Confirm "Continue with the Android toolchain: SDK, NDK, JDK, Gradle cache, user data and environment variables?" || goto :ToolchainKept

:: ---------------------------------------------------------------------------------------------------------------------
call :Section "Running processes"
:: Files in use (adb server, Gradle daemons, a running Editor's adb) can't be deleted
set "SG_DIRS=%SDK_DIR%;%JDK_DIR%"
set "SG_APPLY="
call :Processes
if not defined PROCESS_COUNT (call :Info "None running from the toolchain." & goto :ProcessesDone)
call :Confirm "Stop them?" || (call :Warn "Kept. Folders they use may fail to delete." & goto :ProcessesDone)
set "SG_APPLY=1"
call :Processes
call :Ok "Stopped"
:: Give Windows a moment to release the files
ping -n 3 127.0.0.1 >nul
:ProcessesDone

if not defined PROJECT_RETRY goto :ProjectRetryDone
call :DeleteProjectFiles
if defined PROJECT_LEFT (call :Error "Still in use:%PROJECT_LEFT%. Close the program holding them and run this again.") else (call :Ok "Project generated files deleted")
:ProjectRetryDone

:: ---------------------------------------------------------------------------------------------------------------------
call :Section "Android SDK, NDK and JDK"
call :RemoveDir "Android SDK, NDK, CMake, platform-tools" "%SDK_DIR%" "platform-tools cmdline-tools licenses ndk build-tools platforms"
call :RemoveDir "JDK 17" "%JDK_DIR%" "bin\java.exe"
:: The install folder itself, once empty (rd without /s fails when something else lives there)
if exist "%INSTALL_DIR%\" rd "%INSTALL_DIR%" 2>nul

:: ---------------------------------------------------------------------------------------------------------------------
call :Section "Caches and user data"
call :RemoveDir "Gradle cache, downloaded Gradle versions and daemons" "%GRADLE_DIR%" "caches wrapper daemon"
if exist "%ANDROID_USER_DIR%\avd\" call :Warn "%ANDROID_USER_DIR%\avd holds Android emulator images."
call :RemoveDir "Android user data: adb keys, so phones ask to allow USB debugging again" "%ANDROID_USER_DIR%" "adbkey adbkey.pub avd cache analytics.settings"

:: ---------------------------------------------------------------------------------------------------------------------
call :Section "Environment variables (your user account)"
set "SG_SDK=%SDK_DIR%"
set "SG_JDK=%JDK_DIR%"
set "SG_APPLY="
call :Environment
if not defined ENV_COUNT (call :Info "Nothing points into the toolchain." & goto :EnvDone)
call :Confirm "Remove them?" || (call :Info "Kept." & goto :EnvDone)
set "SG_APPLY=1"
call :Environment
call :Ok "Removed"
:EnvDone

:: ---------------------------------------------------------------------------------------------------------------------
call :Section "Left on this machine (not touched)"
call :Leftovers
goto :Finished

:ToolchainKept
call :Info "Toolchain kept."
if defined PROJECT_RETRY call :Error "Still in use:%PROJECT_LEFT%. Close the program holding them, probably a Gradle daemon, and run this again."

:Finished
echo.
echo %C_OK%============================================================%C_RESET%
echo %C_OK% Android clean finished%C_RESET%
echo %C_OK%============================================================%C_RESET%
echo  - Open a new terminal before running Scripts\AndroidSetup.bat, this one still has the old variables.
echo.
if not defined ASSUME_YES pause
exit /b 0

:Cancelled
echo.
call :Warn "Cancelled, nothing was changed."
if not defined ASSUME_YES pause
exit /b 1

:Usage
echo Usage: AndroidClean.bat [install dir] [/y]
echo   install dir  What was passed to AndroidSetup.bat. Default: the folder above ANDROID_HOME, else %%LOCALAPPDATA%%\Android
echo   /y           Yes to every question, no pause at the end
exit /b 0

:: =====================================================================================================================
:: Helpers. Messages are passed quoted: no ^& ^< ^> or %% in them

:: ShowItem "label" "path": found (with its size) or not
:ShowItem
if exist "%~2" goto :ShowItemFound
echo  %C_DIM%-  %~1  not found%C_RESET%
exit /b 0
:ShowItemFound
set "SG_ITEM=%~2"
set "ITEM_SIZE="
for /f "usebackq delims=" %%s in (`powershell.exe -NoProfile -Command "'{0:N0} MB' -f ((Get-ChildItem -LiteralPath $env:SG_ITEM -Recurse -Force -File -ErrorAction SilentlyContinue | Measure-Object Length -Sum).Sum / 1MB)"`) do set "ITEM_SIZE=%%s"
echo  %C_WARN%x%C_RESET%  %~1  %~2 %C_DIM%(%ITEM_SIZE%)%C_RESET%
exit /b 0

:: Deletes PROJECT_ITEMS from Android\, PROJECT_LEFT lists what could not be deleted (files in use)
:DeleteProjectFiles
set "PROJECT_LEFT="
for %%p in (%PROJECT_ITEMS%) do call :DeleteProjectItem "%ANDROID_DIR%\%%~p" "%%~p"
exit /b 0

:DeleteProjectItem
if not exist "%~1" exit /b 0
if exist "%~1\" goto :DeleteProjectDir
del /q "%~1" 2>nul
goto :DeleteProjectCheck
:DeleteProjectDir
rmdir /s /q "%~1" 2>nul
:DeleteProjectCheck
if exist "%~1" set "PROJECT_LEFT=%PROJECT_LEFT% Android\%~2"
exit /b 0

:: RemoveDir "description" "path" "markers": asks, deletes, verifies. Only deletes a folder containing one of the space separated
:: markers, so a stray ANDROID_HOME / GRADLE_USER_HOME can never point it at an unrelated folder
:RemoveDir
if exist "%~2" goto :RemoveDirCheck
call :Info "%~1: not found"
exit /b 0
:RemoveDirCheck
set "MARKER_FOUND="
for %%m in (%~3) do if exist "%~2\%%~m" set "MARKER_FOUND=1"
if defined MARKER_FOUND goto :RemoveDirAsk
call :Warn "Skipped %~2: it does not look like the %~1 folder."
exit /b 0
:RemoveDirAsk
call :Info "%~2"
call :Confirm "Delete %~1?" || (call :Info "Kept." & exit /b 0)
rmdir /s /q "%~2" 2>nul
if not exist "%~2" goto :RemoveDirDone
call :Error "Could not delete everything in %~2, a program may still be using it. Close it and run this again."
exit /b 1
:RemoveDirDone
call :Ok "Deleted"
exit /b 0

:: Lists (SG_APPLY empty) or stops (SG_APPLY=1) the processes whose executable lives in one of SG_DIRS. Sets PROCESS_COUNT when any
:Processes
set "PROCESS_COUNT="
for /f "usebackq delims=" %%l in (`powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$dirs = $env:SG_DIRS.Split(';') | Where-Object { $_ } | ForEach-Object { $_.TrimEnd('\') + '\' }; Get-CimInstance Win32_Process | Where-Object { $p = $_.ExecutablePath; $p -and ($dirs | Where-Object { $p.StartsWith($_, [StringComparison]::OrdinalIgnoreCase) }) } | ForEach-Object { if ($env:SG_APPLY) { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; '{0} (pid {1})' -f $_.ExecutablePath, $_.ProcessId }"`) do (
    set "PROCESS_COUNT=1"
    if not defined SG_APPLY call :Info "%%l"
)
exit /b 0

:: Lists (SG_APPLY empty) or removes (SG_APPLY=1) the user variables and PATH entries pointing into SG_SDK / SG_JDK. Sets ENV_COUNT when any.
:: Path stays REG_EXPAND_SZ; removing the variables through .NET broadcasts the change to Explorer
:Environment
set "ENV_COUNT="
for /f "usebackq delims=" %%l in (`powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$roots = @($env:SG_SDK, $env:SG_JDK) | ForEach-Object { $_.TrimEnd('\') }; function Inside($v) { $v = [Environment]::ExpandEnvironmentVariables($v).TrimEnd('\'); foreach ($r in $roots) { if ($v -ieq $r -or $v.StartsWith($r + '\', [StringComparison]::OrdinalIgnoreCase)) { return $true } }; return $false }; $k = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true); $path = [string]$k.GetValue('Path', '', 'DoNotExpandEnvironmentNames'); $kept = [Collections.Generic.List[string]]::new(); $removed = $false; foreach ($e in $path.Split(';')) { if (-not $e.Trim()) { continue }; if (Inside $e) { 'PATH entry ' + $e; $removed = $true } else { $kept.Add($e) } }; if ($env:SG_APPLY -and $removed) { $k.SetValue('Path', ($kept -join ';'), [Microsoft.Win32.RegistryValueKind]::ExpandString) }; $k.Close(); foreach ($n in 'JAVA_HOME', 'ANDROID_HOME', 'ANDROID_SDK_ROOT') { $v = [Environment]::GetEnvironmentVariable($n, 'User'); if ($v -and (Inside $v)) { $n + ' = ' + $v; if ($env:SG_APPLY) { [Environment]::SetEnvironmentVariable($n, $null, 'User') } } }"`) do (
    set "ENV_COUNT=1"
    if not defined SG_APPLY call :Info "%%l"
)
exit /b 0

:: What a first-time machine would not have, but this script leaves alone: system-wide or not created by AndroidSetup.bat
:Leftovers
set "LEFTOVER_COUNT="
for /f "usebackq delims=" %%l in (`powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "foreach ($n in 'JAVA_HOME', 'ANDROID_HOME', 'ANDROID_SDK_ROOT', 'ANDROID_NDK_HOME') { foreach ($s in 'User', 'Machine') { $v = [Environment]::GetEnvironmentVariable($n, $s); if ($v) { '{0} variable {1} = {2}' -f $s, $n, $v } } }; foreach ($s in 'User', 'Machine') { ([Environment]::GetEnvironmentVariable('Path', $s) -split ';') | Where-Object { $_ -match 'java|jdk|android|gradle' } | ForEach-Object { '{0} PATH entry {1}' -f $s, $_ } }; Get-ItemProperty 'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*', 'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*', 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*' -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -match 'JDK|Java\b|OpenJDK|Temurin|Android Studio' } | ForEach-Object { 'Installed program: ' + $_.DisplayName + ' (Settings, Apps)' }"`) do (
    set "LEFTOVER_COUNT=1"
    call :Warn "%%l"
)
if not defined LEFTOVER_COUNT call :Ok "Nothing: no other JDK, Android SDK or Android Studio found"
exit /b 0

:InitColors
:: ANSI colors through cmd's own output (echo, set /p): Windows 10+ consoles and Windows Terminal render them.
:: Everything colored is amber, errors are red
for %%c in (RESET TITLE STEP OK WARN ERR DIM ASK BOLD) do set "C_%%c="
if defined NO_COLOR exit /b 0
for /f %%a in ('echo prompt $E^| cmd') do set "ESC=%%a"
set "C_RESET=%ESC%[0m"
set "C_TITLE=%ESC%[38;5;214m"
set "C_STEP=%ESC%[38;5;214m"
set "C_OK=%ESC%[38;5;214m"
set "C_WARN=%ESC%[38;5;214m"
set "C_ERR=%ESC%[91m"
set "C_DIM=%ESC%[38;5;214m"
set "C_ASK=%ESC%[38;5;214m"
set "C_BOLD=%ESC%[1m"
exit /b 0

:Section
echo.
echo %C_STEP%==%C_RESET% %C_BOLD%%~1%C_RESET%
exit /b 0

:Ok
echo   %C_OK%OK%C_RESET% %~1
exit /b 0

:Info
echo   %C_DIM%%~1%C_RESET%
exit /b 0

:Warn
echo   %C_WARN%WARNING%C_RESET% %~1
exit /b 0

:Error
echo   %C_ERR%ERROR %~1%C_RESET%
exit /b 0

:: Prompt "question" "[keys]": printed by set /p (cmd's own output keeps the colors, choice.exe's /m would not)
:Prompt
<nul set /p "=%C_RESET%  %C_ASK%?%C_RESET% %~1 %C_ASK%%~2%C_RESET% "
exit /b 0

:: Confirm "question": errorlevel 0 = yes, 1 = no. /y answers yes
:Confirm
if not defined ASSUME_YES goto :ConfirmAsk
echo   %C_ASK%?%C_RESET% %~1 %C_DIM%yes ^(/y^)%C_RESET%
exit /b 0
:ConfirmAsk
call :Prompt "%~1" "[Y/N]"
choice /c YN /n
if errorlevel 2 exit /b 1
exit /b 0
