<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode / versionName / minSdk / targetSdk are owned by build.gradle (driven by the Export Panel) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Require Vulkan 1.1 (needs Android 10 / API 29+) -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x401000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/SurgeGameTheme"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        >
        <!--
          GameActivity hosts the engine main loop.
          android:name points to the GameActivity class which loads the
          shared library named in meta-data below.
        -->
        <activity
            android:name=".SurgeActivity"
            android:theme="@style/SurgeGameTheme"
            android:screenOrientation="${surgeOrientation}"
            android:resizeableActivity="false"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|keyboardHidden|screenSize|density"
            android:exported="true">

            <!-- Name of the .so built by CMake (without "lib" prefix and ".so" suffix) -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="SurgePlayer" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>